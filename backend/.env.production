# CredenceAI — Production mode profile (self-hosted reference)
# Copy to .env and fill secrets: cp .env.production .env
APP_ENV=production
APP_NAME=credenceai
MOCK_SERVICES=false
CELERY_ALWAYS_EAGER=false
OPENAI_API_KEY=
DATABASE_URL=postgresql://user:pass@localhost:5432/credenceai
REDIS_URL=redis://localhost:6379/0
SEARCH_BACKEND=database
STORAGE_BACKEND=local
SEARCH_PROVIDER=duckduckgo
ENABLE_API_KEY_AUTH=true
CORS_ALLOWED_ORIGINS=["https://your-frontend.vercel.app"]
JWT_SECRET=
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO
ENABLE_AGENTIC_PIPELINE=true
AGENT_MAX_ITERATIONS=5
SELF_KEEPALIVE_ENABLED=false
